<Window x:Class="ForcePaste.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForcePaste" Height="550" Width="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Opacity="0">
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- 侧边栏图标按钮样式 -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#B0B0B0"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="8" Margin="7,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#333333"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="bg" Property="Background" Value="#404040"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#FFFFFF" CornerRadius="14" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="65"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 左侧深色侧边栏 ========== -->
            <Border Grid.Column="0" Background="#1F1F1F" CornerRadius="14,0,0,14" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 剪贴板 -->
                    <Button Grid.Row="0" x:Name="BtnClipboard" Style="{StaticResource SidebarButton}"
                            Tag="Selected" ToolTip="剪贴板" Click="BtnClipboard_Click">
                        <TextBlock Text="&#x1F4CB;" FontSize="20"/>
                    </Button>

                    <!-- 粘贴设置 -->
                    <Button Grid.Row="1" x:Name="BtnPasteSettings" Style="{StaticResource SidebarButton}"
                            ToolTip="粘贴设置" Click="BtnPasteSettings_Click">
                        <TextBlock Text="&#x2699;&#xFE0F;" FontSize="20"/>
                    </Button>

                    <!-- 快捷键设置 -->
                    <Button Grid.Row="2" x:Name="BtnHotkeySettings" Style="{StaticResource SidebarButton}"
                            ToolTip="快捷键设置" Click="BtnHotkeySettings_Click">
                        <TextBlock Text="&#x2328;&#xFE0F;" FontSize="20"/>
                    </Button>

                    <!-- 退出（底部） -->
                    <Button Grid.Row="4" x:Name="BtnExit" Style="{StaticResource SidebarButton}"
                            ToolTip="退出程序" Click="BtnExit_Click" Margin="0,0,0,12">
                        <TextBlock Text="&#x23FB;" FontSize="22"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ========== 右侧内容区 ========== -->
            <Border Grid.Column="1" Background="#FAFAFA" CornerRadius="0,14,14,0" ClipToBounds="True">
                <Grid Margin="24,20,24,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 页面标题 -->
                    <TextBlock x:Name="PageTitle" Grid.Row="0" Text="剪贴板"
                               FontSize="20" FontWeight="SemiBold" Foreground="#222" Margin="0,0,0,16"/>

                    <!-- ===== 页面1: 剪贴板 ===== -->
                    <Grid x:Name="PageClipboard" Grid.Row="1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Background="#F0F0F0" CornerRadius="10" Padding="14">
                            <TextBox x:Name="ClipboardText" IsReadOnly="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                     Background="Transparent" FontSize="13" Foreground="#333"
                                     Text="暂无剪贴板内容"/>
                        </Border>
                        <Button Grid.Row="1" Content="  刷新" HorizontalAlignment="Right"
                                Margin="0,12,0,0" Padding="14,6" FontSize="13"
                                Background="#E8E8E8" Foreground="#333" BorderThickness="0"
                                Cursor="Hand" Click="BtnRefreshClipboard_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>

                    <!-- ===== 页面2: 粘贴设置 ===== -->
                    <StackPanel x:Name="PagePasteSettings" Grid.Row="1" Visibility="Collapsed">
                        <!-- 基础速度 -->
                        <StackPanel Margin="0,0,0,24">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="基础速度 (ms)" FontSize="13" Foreground="#666"/>
                                <TextBlock x:Name="SpeedValue" Text="30" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#333" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="SpeedSlider" Minimum="5" Maximum="500" Value="30"
                                    TickFrequency="10" IsSnapToTickEnabled="True"
                                    ValueChanged="SpeedSlider_ValueChanged"/>
                        </StackPanel>

                        <!-- 波动范围 -->
                        <StackPanel Margin="0,0,0,24">
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="波动范围 (ms)" FontSize="13" Foreground="#666"/>
                                <TextBlock x:Name="RandomValue" Text="10" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#333" HorizontalAlignment="Right"/>
                            </Grid>
                            <Slider x:Name="RandomSlider" Minimum="0" Value="10"
                                    TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="RandomSlider_ValueChanged"/>
                        </StackPanel>

                        <TextBlock Text=" 基础速度决定每个字符的输入间隔，波动范围让间隔产生随机变化，模拟真人打字节奏。"
                                   FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- ===== 页面3: 快捷键设置 ===== -->
                    <StackPanel x:Name="PageHotkeySettings" Grid.Row="1" Visibility="Collapsed">
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="当前快捷键" FontSize="12" Foreground="#888" Margin="0,0,0,6"/>
                            <TextBlock x:Name="CurrentHotkeyDisplay" Text="Ctrl + Alt + V"
                                       FontSize="22" FontWeight="SemiBold" Foreground="#222"
                                       HorizontalAlignment="Center" Margin="0,8,0,20"/>
                        </StackPanel>

                        <Border Background="#F0F0F0" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="按下新的快捷键组合" FontSize="12" Foreground="#888"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBox x:Name="HotkeyCaptureBox" IsReadOnly="True"
                                         Text="在此处按下快捷键..." FontSize="16" FontWeight="SemiBold"
                                         Foreground="#555" HorizontalContentAlignment="Center"
                                         Padding="12,10" Background="White" BorderThickness="1"
                                         BorderBrush="#D0D0D0" PreviewKeyDown="HotkeyCaptureBox_PreviewKeyDown"/>
                                <TextBlock x:Name="HotkeyHint" Text="直接按下你想设置的组合键即可"
                                           FontSize="11" Foreground="#AAA" HorizontalAlignment="Center"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BtnApplyHotkey" Content="应用快捷键" HorizontalAlignment="Center"
                                Padding="28,10" FontSize="14" FontWeight="SemiBold"
                                Background="#4A90E2" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="BtnApplyHotkey_Click" IsEnabled="False">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="8"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="恢复默认 (Ctrl+Alt+V)" HorizontalAlignment="Center"
                                Margin="0,10,0,0" Padding="20,8" FontSize="12"
                                Background="Transparent" Foreground="#4A90E2" BorderThickness="0"
                                Cursor="Hand" Click="BtnResetHotkey_Click"/>
                    </StackPanel>

                    <!-- ===== 页面4: 退出确认 ===== -->
                    <StackPanel x:Name="PageExit" Grid.Row="1" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="👋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                        <TextBlock Text="确定要退出 ForcePaste 吗？" FontSize="16" Foreground="#333"
                                   HorizontalAlignment="Center" Margin="0,0,0,24"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="取消" Padding="24,10" FontSize="14" Margin="0,0,16,0"
                                    Background="#E8E8E8" Foreground="#333" BorderThickness="0"
                                    Cursor="Hand" Click="BtnExitCancel_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="确认退出" Padding="24,10" FontSize="14"
                                    Background="#FF6B6B" Foreground="White" BorderThickness="0"
                                    Cursor="Hand" Click="BtnExitConfirm_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
