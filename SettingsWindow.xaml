<Window x:Class="ForcePaste.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForcePaste 选项" Height="360" Width="200" 
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Opacity="0">
    <Window.Resources>
        <!-- 弹出的过度淡入动画 -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
        </Storyboard>
    </Window.Resources>
    
    <Border Background="White" CornerRadius="12" Margin="10">
        <!-- 投影效果 -->
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.2"/>
        </Border.Effect>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/> <!-- 新增退出按钮行 -->
            </Grid.RowDefinitions>

            <TextBlock Text="ForcePaste" FontWeight="Bold" FontSize="16" Foreground="#333" Margin="0,0,0,15" HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1" Margin="0,0,0,15">
                <TextBlock Text="基础速度 (ms):" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                <Slider x:Name="SpeedSlider" Minimum="5" Maximum="500" Value="30" TickFrequency="10" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding Value, ElementName=SpeedSlider, StringFormat={}{0}}" HorizontalAlignment="Right" FontSize="12"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="波动范围 (ms):" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>
                <Slider x:Name="RandomSlider" Minimum="0" Maximum="{Binding Value, ElementName=SpeedSlider}" Value="10" TickFrequency="5" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding Value, ElementName=RandomSlider, StringFormat={}{0}}" HorizontalAlignment="Right" FontSize="12"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,15">
                <TextBlock Text="快捷键:" FontSize="12" Foreground="Gray"/>
                <TextBlock Text="Ctrl+Alt+V" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,5,0,0"/>
            </StackPanel>
            
            <TextBlock Grid.Row="4" Text="悬停隐藏，点击固定。" TextAlignment="Center" TextWrapping="Wrap" Foreground="DarkGray" FontSize="10" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
            
            <!-- 新增的退出程序按钮 -->
            <Button Grid.Row="5" Content="退出程序" Background="#FF6B6B" Foreground="White" BorderThickness="0" Padding="0,5" Click="BtnExit_Click"/>
        </Grid>
    </Border>
</Window>
