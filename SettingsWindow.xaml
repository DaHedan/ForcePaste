<Window x:Class="ForcePaste.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForcePaste" Height="580" Width="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Opacity="0">
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- ===== 侧边栏按钮：强发光悬停 + 按压缩放 ===== -->
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="{DynamicResource SidebarBtnNormalBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarIconNormalBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Margin="8,2">
                            <!-- 发光层 -->
                            <Border x:Name="glowLayer"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                                      Color="{DynamicResource AccentColor}" Opacity="1"/>
                                </Border.Effect>
                            </Border>
                            <!-- 内容层 -->
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.8" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource SidebarBtnHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.9" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.9" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource SidebarBtnSelectedBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SidebarIconSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 主题选择按钮：强发光悬停 + 按压缩放 ===== -->
        <Style x:Key="ThemeBtn" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource ContentFontSize}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glowLayer"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="10"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                                                      Color="{DynamicResource AccentColor}" Opacity="1"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="10" Padding="12,0"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.7" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 主操作按钮（应用快捷键）：强发光 + 按压 ===== -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnAccentBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnAccentFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glowLayer"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    Opacity="0.4"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="0"
                                                      Color="{DynamicResource AccentColor}" Opacity="1"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="glowLayer" Property="Opacity" Value="0"/>
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource BtnDefaultBgBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.85" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 默认按钮（刷新/取消）：强发光 + 按压 ===== -->
        <Style x:Key="DefaultBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnDefaultBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnDefaultFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glowLayer"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    Opacity="0"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0"
                                                      Color="{DynamicResource AccentColor}" Opacity="1"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.7" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 危险按钮（确认退出）：红色强发光 + 按压 ===== -->
        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnDangerBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnDangerFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="glowLayer"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    Opacity="0.3"
                                    IsHitTestVisible="False">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="20" ShadowDepth="0"
                                                      Color="{DynamicResource DangerColor}" Opacity="1"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="9"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.8" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.3" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 文字按钮（恢复默认等次要操作） ===== -->
        <Style x:Key="TextBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="scale" ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <!-- 发光底层 -->
                            <Border x:Name="glowLayer"
                                    CornerRadius="6"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource AccentBrush}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0"
                                                      Color="{DynamicResource AccentColor}" Opacity="1"/>
                                </Border.Effect>
                            </Border>
                            <ContentPresenter x:Name="content"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.3" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="glowLayer"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.95" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.95" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <BackEase Amplitude="0.3"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 自定义滑块样式 ===== -->
        <Style x:Key="ThemeSlider" TargetType="Slider">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Opacity="0.6"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Width="22" Height="22">
                                                    <!-- 发光光晕 -->
                                                    <Ellipse x:Name="glow" Width="22" Height="22"
                                                             Fill="{DynamicResource SliderThumbBrush}"
                                                             Opacity="0.35">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="14" ShadowDepth="0"
                                                                              Color="{DynamicResource AccentColor}" Opacity="1"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <!-- 实体圆点 -->
                                                    <Ellipse x:Name="thumb" Width="14" Height="14"
                                                             Fill="{DynamicResource SliderThumbBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.15"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="glow" Property="Opacity" Value="0.65"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="glow" Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3"
                                                        Background="{DynamicResource SliderTrackBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ContentBgBrush}" CornerRadius="14" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧侧边栏 ===== -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
                    CornerRadius="14,0,0,14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="BtnClipboard" Style="{StaticResource SidebarButton}"
                            Tag="Selected" ToolTip="剪贴板" Click="BtnClipboard_Click" Margin="0,12,0,0">
                        <TextBlock Text="&#x1F4CB;" FontSize="22" FontFamily="Segoe UI Emoji"/>
                    </Button>
                    <Button Grid.Row="1" x:Name="BtnPaste" Style="{StaticResource SidebarButton}"
                            ToolTip="粘贴设置" Click="BtnPaste_Click">
                        <TextBlock Text="&#x2699;&#xFE0F;" FontSize="22" FontFamily="Segoe UI Emoji"/>
                    </Button>
                    <Button Grid.Row="2" x:Name="BtnHotkey" Style="{StaticResource SidebarButton}"
                            ToolTip="快捷键" Click="BtnHotkey_Click">
                        <TextBlock Text="&#x2328;&#xFE0F;" FontSize="22" FontFamily="Segoe UI Emoji"/>
                    </Button>
                    <Button Grid.Row="3" x:Name="BtnTheme" Style="{StaticResource SidebarButton}"
                            ToolTip="外观设置" Click="BtnTheme_Click">
                        <TextBlock Text="&#x1F3A8;" FontSize="22" FontFamily="Segoe UI Emoji"/>
                    </Button>

                    <Button Grid.Row="5" x:Name="BtnExit" Style="{StaticResource SidebarButton}"
                            ToolTip="退出程序" Click="BtnExit_Click" Margin="0,0,0,14">
                        <TextBlock Text="&#x2716;" FontSize="18" FontFamily="Segoe UI Emoji"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== 右侧内容区 ===== -->
            <Grid Grid.Column="1" Margin="28,24,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="PageTitle" Grid.Row="0" Text="剪贴板"
                           FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,20"/>

                <!-- ===== Page 1: 剪贴板 ===== -->
                <Grid x:Name="PageClipboard" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource ClipAreaBgBrush}"
                            CornerRadius="10" Padding="16">
                        <TextBox x:Name="ClipboardText" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="{DynamicResource ContentFontSize}"
                                 Foreground="{DynamicResource ClipAreaFgBrush}"
                                 Text="暂无剪贴板内容"/>
                    </Border>
                    <Button Grid.Row="1" Content="  刷新" HorizontalAlignment="Right"
                            Margin="0,14,0,0" Padding="16,7"
                            FontSize="{DynamicResource ContentFontSize}"
                            Style="{StaticResource DefaultBtn}"
                            Click="BtnRefreshClipboard_Click"/>
                </Grid>

                <!-- ===== Page 2: 粘贴设置 ===== -->
                <StackPanel x:Name="PagePasteSettings" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,28">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="基础速度 (ms)"
                                       FontSize="{DynamicResource ContentFontSize}"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="SpeedValue" Text="30"
                                       FontSize="{DynamicResource ContentFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SpeedSlider" Minimum="5" Maximum="500" Value="5"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                Style="{StaticResource ThemeSlider}"
                                ValueChanged="SpeedSlider_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,28">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="波动范围 (ms)"
                                       FontSize="{DynamicResource ContentFontSize}"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="RandomValue" Text="10"
                                       FontSize="{DynamicResource ContentFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="RandomSlider" Minimum="0" Value="0"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                Style="{StaticResource ThemeSlider}"
                                ValueChanged="RandomSlider_ValueChanged"/>
                    </StackPanel>
                    <TextBlock
                        FontSize="{DynamicResource SmallFontSize}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        TextWrapping="Wrap" Margin="0,4,0,0"
                        Text=" 基础速度决定每个字符的输入间隔，波动范围让间隔产生随机变化，模拟真人打字节奏。"/>
                </StackPanel>

                <!-- ===== Page 3: 快捷键设置 ===== -->
                <StackPanel x:Name="PageHotkeySettings" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="当前快捷键"
                                   FontSize="{DynamicResource ContentFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="CurrentHotkeyDisplay" Text="Ctrl + Alt + V"
                                   FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,24"/>
                    </StackPanel>

                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="按下新的快捷键组合"
                                       FontSize="{DynamicResource ContentFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBox x:Name="HotkeyCaptureBox" IsReadOnly="True"
                                     Text="在此处按下快捷键..."
                                     FontSize="{DynamicResource ContentFontSize}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextBrush}"
                                     HorizontalContentAlignment="Center"
                                     Padding="14,12" Background="{DynamicResource InputBgBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     PreviewKeyDown="HotkeyCaptureBox_PreviewKeyDown">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock x:Name="HotkeyHint"
                                       Text="直接按下你想设置的组合键即可"
                                       FontSize="{DynamicResource SmallFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnApplyHotkey" Content="应用快捷键"
                            HorizontalAlignment="Center"
                            Padding="32,12" FontSize="{DynamicResource ContentFontSize}"
                            FontWeight="SemiBold"
                            Style="{StaticResource AccentBtn}"
                            Click="BtnApplyHotkey_Click"
                            IsEnabled="False"/>

                    <Button Content="恢复默认 (Ctrl+Alt+V)" HorizontalAlignment="Center"
                            Margin="0,14,0,0" Padding="20,8"
                            FontSize="{DynamicResource SmallFontSize}"
                            Style="{StaticResource TextBtn}"
                            Click="BtnResetHotkey_Click"/>
                </StackPanel>

                <!-- ===== Page 4: 外观设置 ===== -->
                <ScrollViewer x:Name="PageThemeSettings" Grid.Row="1" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="选择主题" FontSize="{DynamicResource ContentFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button x:Name="ThemeBtnLight" Style="{StaticResource ThemeBtn}"
                                    Width="100" Margin="0,0,8,0" Click="ThemeBtn_Click" Tag="Light">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x2600;&#xFE0F;" FontSize="26" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Text="浅色"
                                               FontSize="{DynamicResource ContentFontSize}"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeBtnDark" Style="{StaticResource ThemeBtn}"
                                    Width="100" Margin="0,0,8,0" Click="ThemeBtn_Click" Tag="Dark">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x1F319;" FontSize="26" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Text="深色"
                                               FontSize="{DynamicResource ContentFontSize}"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeBtnSystem" Style="{StaticResource ThemeBtn}"
                                    Width="100" Click="ThemeBtn_Click" Tag="System">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x1F5A5;&#xFE0F;" FontSize="26" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Text="跟随系统"
                                               FontSize="{DynamicResource ContentFontSize}"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Background="{DynamicResource CardBgBrush}"
                                CornerRadius="10" Padding="16" Margin="0,0,0,24">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="浅色主题"
                                           FontSize="{DynamicResource ContentFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,4"/>
                                <TextBlock
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" Margin="0,0,0,14"
                                    Text="明亮清爽的界面，适合白天或光线充足的环境。"/>
                                <TextBlock Text="深色主题"
                                           FontSize="{DynamicResource ContentFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,4"/>
                                <TextBlock
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" Margin="0,0,0,14"
                                    Text="沉稳低调的界面，减少眼部疲劳，适合夜间使用。"/>
                                <TextBlock Text="跟随系统"
                                           FontSize="{DynamicResource ContentFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,4"/>
                                <TextBlock
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="自动匹配 Windows 系统主题设置，切换系统主题时同步变化。"/>
                            </StackPanel>
                        </Border>

                        <!-- ===== 字体大小设置 ===== -->
                        <TextBlock Text="字体大小"
                                   FontSize="{DynamicResource ContentFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="FontSizeSlider" Grid.Column="0"
                                    Minimum="11" Maximum="18" Value="13"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ThemeSlider}"
                                    ValueChanged="FontSizeSlider_ValueChanged"/>
                            <TextBlock x:Name="FontSizeValue" Grid.Column="1"
                                       Text="13" FontSize="{DynamicResource ContentFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock
                            FontSize="{DynamicResource SmallFontSize}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextWrapping="Wrap" Margin="0,4,0,0"
                            Text="调整界面文字大小，拖动滑块即时生效。"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page 5: 退出确认 ===== -->
                <StackPanel x:Name="PageExit" Grid.Row="1" Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Border Background="{DynamicResource ExitEmojiBgBrush}"
                            CornerRadius="32" Width="64" Height="64"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="&#x1F44B;" FontSize="32"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Emoji"/>
                    </Border>
                    <TextBlock Text="确定要退出 ForcePaste 吗？"
                               FontSize="{DynamicResource ContentFontSize}"
                               Foreground="{DynamicResource TitleBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,28"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="取消" Padding="28,11"
                                FontSize="{DynamicResource ContentFontSize}"
                                Margin="0,0,16,0"
                                Style="{StaticResource DefaultBtn}"
                                Click="BtnExitCancel_Click"/>
                        <Button Content="确认退出" Padding="28,11"
                                FontSize="{DynamicResource ContentFontSize}"
                                Style="{StaticResource DangerBtn}"
                                Click="BtnExitConfirm_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
