<Window x:Class="ForcePaste.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForcePaste" Height="580" Width="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        Opacity="0">
    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
        </Storyboard>
        <Storyboard x:Key="FadeOut">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
        </Storyboard>

        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Background" Value="{DynamicResource SidebarBtnNormalBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarIconNormalBrush}"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="10" Margin="9,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource SidebarBtnHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource SidebarBtnSelectedBrush}"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource SidebarIconSelectedBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemeBtn" TargetType="Button">
            <Setter Property="Height" Value="56"/>
            <Setter Property="Background" Value="{DynamicResource ThemeCardBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource ContentFontSize}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="10" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnAccentBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnAccentFgBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource BtnDefaultBgBrush}"/>
                                <Setter TargetName="bg" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground"
                                        Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{DynamicResource ContentBgBrush}" CornerRadius="14" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== 左侧侧边栏 ===== -->
            <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
                    CornerRadius="14,0,0,14" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" x:Name="BtnClipboard" Style="{StaticResource SidebarButton}"
                            Tag="Selected" ToolTip="剪贴板" Click="BtnClipboard_Click" Margin="0,12,0,0">
                        <TextBlock Text="&#x1F4CB;" FontSize="22" FontFamily="Segoe UI Emoji"/>
                    </Button>
                    <Button Grid.Row="1" x:Name="BtnPaste" Style="{StaticResource SidebarButton}"
                            ToolTip="粘贴设置" Click="BtnPaste_Click">
                        <TextBlock Text="&#x2699;&#xFE0F;" FontSize="22" FontFamily="Segoe UI Emoji"/>
                    </Button>
                    <Button Grid.Row="2" x:Name="BtnHotkey" Style="{StaticResource SidebarButton}"
                            ToolTip="快捷键" Click="BtnHotkey_Click">
                        <TextBlock Text="&#x2328;&#xFE0F;" FontSize="22" FontFamily="Segoe UI Emoji"/>
                    </Button>
                    <Button Grid.Row="3" x:Name="BtnTheme" Style="{StaticResource SidebarButton}"
                            ToolTip="外观设置" Click="BtnTheme_Click">
                        <TextBlock Text="&#x1F3A8;" FontSize="22" FontFamily="Segoe UI Emoji"/>
                    </Button>

                    <Button Grid.Row="5" x:Name="BtnExit" Style="{StaticResource SidebarButton}"
                            ToolTip="退出程序" Click="BtnExit_Click" Margin="0,0,0,14">
                        <TextBlock Text="&#x2716;" FontSize="18" FontFamily="Segoe UI Emoji"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== 右侧内容区 ===== -->
            <Grid Grid.Column="1" Margin="28,24,24,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="PageTitle" Grid.Row="0" Text="剪贴板"
                           FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,20"/>

                <!-- ===== Page 1: 剪贴板 ===== -->
                <Grid x:Name="PageClipboard" Grid.Row="1" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource ClipAreaBgBrush}"
                            CornerRadius="10" Padding="16">
                        <TextBox x:Name="ClipboardText" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="{DynamicResource ContentFontSize}"
                                 Foreground="{DynamicResource ClipAreaFgBrush}"
                                 Text="暂无剪贴板内容"/>
                    </Border>
                    <Button Grid.Row="1" Content="  刷新" HorizontalAlignment="Right"
                            Margin="0,14,0,0" Padding="16,7"
                            FontSize="{DynamicResource ContentFontSize}"
                            Background="{DynamicResource BtnDefaultBgBrush}"
                            Foreground="{DynamicResource BtnDefaultFgBrush}"
                            BorderThickness="0" Cursor="Hand" Click="BtnRefreshClipboard_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="7"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- ===== Page 2: 粘贴设置 ===== -->
                <StackPanel x:Name="PagePasteSettings" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,28">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="基础速度 (ms)"
                                       FontSize="{DynamicResource ContentFontSize}"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="SpeedValue" Text="30"
                                       FontSize="{DynamicResource ContentFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="SpeedSlider" Minimum="5" Maximum="500" Value="30"
                                TickFrequency="10" IsSnapToTickEnabled="True"
                                ValueChanged="SpeedSlider_ValueChanged"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,28">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="波动范围 (ms)"
                                       FontSize="{DynamicResource ContentFontSize}"
                                       Foreground="{DynamicResource TextBrush}"/>
                            <TextBlock x:Name="RandomValue" Text="10"
                                       FontSize="{DynamicResource ContentFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <Slider x:Name="RandomSlider" Minimum="0" Value="10"
                                TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="RandomSlider_ValueChanged"/>
                    </StackPanel>
                    <TextBlock
                        FontSize="{DynamicResource SmallFontSize}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                        TextWrapping="Wrap" Margin="0,4,0,0"
                        Text=" 基础速度决定每个字符的输入间隔，波动范围让间隔产生随机变化，模拟真人打字节奏。"/>
                </StackPanel>

                <!-- ===== Page 3: 快捷键设置 ===== -->
                <StackPanel x:Name="PageHotkeySettings" Grid.Row="1" Visibility="Collapsed">
                    <StackPanel Margin="0,0,0,24">
                        <TextBlock Text="当前快捷键"
                                   FontSize="{DynamicResource ContentFontSize}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="CurrentHotkeyDisplay" Text="Ctrl + Alt + V"
                                   FontSize="{DynamicResource TitleFontSize}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,24"/>
                    </StackPanel>

                    <Border Background="{DynamicResource CardBgBrush}"
                            CornerRadius="12" Padding="20" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.08"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="按下新的快捷键组合"
                                       FontSize="{DynamicResource ContentFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBox x:Name="HotkeyCaptureBox" IsReadOnly="True"
                                     Text="在此处按下快捷键..."
                                     FontSize="{DynamicResource ContentFontSize}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextBrush}"
                                     HorizontalContentAlignment="Center"
                                     Padding="14,12" Background="{DynamicResource InputBgBrush}"
                                     BorderThickness="1"
                                     BorderBrush="{DynamicResource InputBorderBrush}"
                                     PreviewKeyDown="HotkeyCaptureBox_PreviewKeyDown">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                            <TextBlock x:Name="HotkeyHint"
                                       Text="直接按下你想设置的组合键即可"
                                       FontSize="{DynamicResource SmallFontSize}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnApplyHotkey" Content="应用快捷键"
                            HorizontalAlignment="Center"
                            Padding="32,12" FontSize="{DynamicResource ContentFontSize}"
                            FontWeight="SemiBold"
                            Style="{StaticResource AccentBtn}"
                            Cursor="Hand" Click="BtnApplyHotkey_Click"
                            IsEnabled="False">
                    </Button>

                    <Button Content="恢复默认 (Ctrl+Alt+V)" HorizontalAlignment="Center"
                            Margin="0,14,0,0" Padding="20,8"
                            FontSize="{DynamicResource SmallFontSize}"
                            Background="Transparent"
                            Foreground="{DynamicResource AccentBrush}"
                            BorderThickness="0" Cursor="Hand" Click="BtnResetHotkey_Click"/>
                </StackPanel>

                <!-- ===== Page 4: 外观设置 ===== -->
                <ScrollViewer x:Name="PageThemeSettings" Grid.Row="1" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="选择主题" FontSize="{DynamicResource ContentFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,16"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                            <Button x:Name="ThemeBtnLight" Style="{StaticResource ThemeBtn}"
                                    Width="100" Margin="0,0,8,0" Click="ThemeBtn_Click" Tag="Light">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x2600;&#xFE0F;" FontSize="26" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Text="浅色"
                                               FontSize="{DynamicResource ContentFontSize}"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeBtnDark" Style="{StaticResource ThemeBtn}"
                                    Width="100" Margin="0,0,8,0" Click="ThemeBtn_Click" Tag="Dark">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x1F319;" FontSize="26" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Text="深色"
                                               FontSize="{DynamicResource ContentFontSize}"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ThemeBtnSystem" Style="{StaticResource ThemeBtn}"
                                    Width="100" Click="ThemeBtn_Click" Tag="System">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="&#x1F5A5;&#xFE0F;" FontSize="26" HorizontalAlignment="Center"
                                               FontFamily="Segoe UI Emoji"/>
                                    <TextBlock Text="跟随系统"
                                               FontSize="{DynamicResource ContentFontSize}"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Background="{DynamicResource CardBgBrush}"
                                CornerRadius="10" Padding="16" Margin="0,0,0,24">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="浅色主题"
                                           FontSize="{DynamicResource ContentFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,4"/>
                                <TextBlock
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" Margin="0,0,0,14"
                                    Text="明亮清爽的界面，适合白天或光线充足的环境。"/>
                                <TextBlock Text="深色主题"
                                           FontSize="{DynamicResource ContentFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,4"/>
                                <TextBlock
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" Margin="0,0,0,14"
                                    Text="沉稳低调的界面，减少眼部疲劳，适合夜间使用。"/>
                                <TextBlock Text="跟随系统"
                                           FontSize="{DynamicResource ContentFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,4"/>
                                <TextBlock
                                    FontSize="{DynamicResource SmallFontSize}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="自动匹配 Windows 系统主题设置，切换系统主题时同步变化。"/>
                            </StackPanel>
                        </Border>

                        <!-- ===== 字体大小设置 ===== -->
                        <TextBlock Text="字体大小"
                                   FontSize="{DynamicResource ContentFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBrush}" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="FontSizeSlider" Grid.Column="0"
                                    Minimum="11" Maximum="18" Value="13"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    ValueChanged="FontSizeSlider_ValueChanged"/>
                            <TextBlock x:Name="FontSizeValue" Grid.Column="1"
                                       Text="13" FontSize="{DynamicResource ContentFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock
                            FontSize="{DynamicResource SmallFontSize}"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            TextWrapping="Wrap" Margin="0,4,0,0"
                            Text="调整界面文字大小，拖动滑块即时生效。"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== Page 5: 退出确认 ===== -->
                <StackPanel x:Name="PageExit" Grid.Row="1" Visibility="Collapsed"
                            VerticalAlignment="Center">
                    <Border Background="{DynamicResource ExitEmojiBgBrush}"
                            CornerRadius="32" Width="64" Height="64"
                            HorizontalAlignment="Center" Margin="0,0,0,20">
                        <TextBlock Text="&#x1F44B;" FontSize="32"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Emoji"/>
                    </Border>
                    <TextBlock Text="确定要退出 ForcePaste 吗？"
                               FontSize="{DynamicResource ContentFontSize}"
                               Foreground="{DynamicResource TitleBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,28"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="取消" Padding="28,11"
                                FontSize="{DynamicResource ContentFontSize}"
                                Margin="0,0,16,0"
                                Background="{DynamicResource BtnDefaultBgBrush}"
                                Foreground="{DynamicResource BtnDefaultFgBrush}"
                                BorderThickness="0" Cursor="Hand" Click="BtnExitCancel_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="9"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="确认退出" Padding="28,11"
                                FontSize="{DynamicResource ContentFontSize}"
                                Background="{DynamicResource BtnDangerBgBrush}"
                                Foreground="{DynamicResource BtnDangerFgBrush}"
                                BorderThickness="0" Cursor="Hand" Click="BtnExitConfirm_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="9"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
