<Window x:Class="ForcePaste.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForcePaste" Height="56" Width="56"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        LocationChanged="Window_LocationChanged"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove">
    <Grid>
        <!-- 固定环（pinned 时显示） -->
        <Ellipse x:Name="PinRing" Margin="1" StrokeThickness="2.5"
                 Stroke="{DynamicResource BallPinRingBrush}"
                 Opacity="0" IsHitTestVisible="False"/>

        <!-- 球体 -->
        <Ellipse x:Name="BallShape" Margin="4" Cursor="Hand"
                 Fill="{DynamicResource BallFillBrush}">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 剪贴板 + 光标箭头图标（logo 核心元素） -->
        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False">
            <Canvas Width="24" Height="24">
                <!-- 剪贴板 -->
                <Path Data="M18,20H6V4H8V7H16V4H18M13,3V1H11V3H13M18,3H17V1H15V3H9V1H7V3H6A2,2 0 0,0 4,5V21A2,2 0 0,0 6,23H18A2,2 0 0,0 20,21V5A2,2 0 0,0 18,3Z"
                      Fill="{DynamicResource BallIconBrush}"/>
                <!-- 光标箭头（右下） -->
                <Path Data="M0,0 L0,11 L3,7.5 L6.5,13 L8,12 L4.5,6.5 L9,6.5 Z"
                      Fill="{DynamicResource BallIconBrush}">
                    <Path.RenderTransform>
                        <TranslateTransform X="14" Y="12"/>
                    </Path.RenderTransform>
                </Path>
            </Canvas>
        </Viewbox>
    </Grid>
</Window>
