<Window x:Class="ForcePaste.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ForcePaste" Height="56" Width="56"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        LocationChanged="Window_LocationChanged"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseLeftButtonUp="Window_MouseLeftButtonUp"
        MouseMove="Window_MouseMove">
    <Grid>
        <!-- 固定环（pinned 时显示） -->
        <Ellipse x:Name="PinRing" Margin="1" StrokeThickness="2.5"
                 Stroke="{DynamicResource BallPinRingBrush}"
                 Opacity="0" IsHitTestVisible="False"/>

        <!-- 球体 -->
        <Ellipse x:Name="BallShape" Margin="4" Cursor="Hand"
                 Fill="{DynamicResource BallFillBrush}">
            <Ellipse.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.3"/>
            </Ellipse.Effect>
        </Ellipse>

        <!-- 剪贴板图标 -->
        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False">
            <Path Data="M19,20H5V4H7V7H17V4H19M13,3V1H11V3H13M19,3H18V1H16V3H8V1H6V3H5A2,2 0 0,0 3,5V21A2,2 0 0,0 5,23H19A2,2 0 0,0 21,21V5A2,2 0 0,0 19,3Z"
                  Fill="{DynamicResource BallIconBrush}"/>
        </Viewbox>
    </Grid>
</Window>
